[node name="CrimpingTool" parent="Minigame" node_paths=PackedStringArray("dialog_box") instance=ExtResource("7_5cmuk")]
position = Vector2(614, 178)
dialog_box = NodePath("../../CanvasLayer/DialogBox")
item_display_name = "Teacher"
final_message = "Great job! You’ve got all your gear on. Let’s get to building!"
item_info = Array[String](["Anti-Static Wrist Strap - This is your primary defense against Electrostatic Discharge (ESD).", "It clips onto a grounded metal object (like your PC case) and ensures that you and the computer stay at the same electrical potential. ", "It prevents you from accidentally \"frying\" a $500 CPU with a tiny spark from your fingertip."])
texture = ExtResource("6_gi44t")
item_name = "Anti-Static Strap"

[node name="LANCable" parent="Minigame" node_paths=PackedStringArray("dialog_box") instance=ExtResource("7_5cmuk")]
position = Vector2(281, 102)
dialog_box = NodePath("../../CanvasLayer/DialogBox")
item_display_name = "Teacher"
final_message = "Great job! You’ve got all your gear on. Let’s get to building!"
item_info = Array[String](["Anti-Static Gloves - Many modern PC cases are made of stamped steel with unfinished internal edges. ", "Thin, snug-fitting gloves protect your hands from \"case bites\" (nasty slices from sharp metal). ", "Additionally, they prevent skin oils from getting onto the gold contact points of your RAM and GPU, which can cause corrosion over time."])
texture = ExtResource("7_4fei7")
item_name = "Anti-Static Gloves"

[node name="WireStripper" parent="Minigame" node_paths=PackedStringArray("dialog_box") instance=ExtResource("7_5cmuk")]
position = Vector2(-392, 83)
dialog_box = NodePath("../../CanvasLayer/DialogBox")
item_display_name = "Teacher"
final_message = "Great job! You’ve got all your gear on. Let’s get to building!"
item_info = Array[String](["LED Headlamp - Shadows are the enemy of a safe build. ", "Trying to plug in a tiny Front Panel connector in the dark leads to bent pins and frustration. ", "A headlamp keeps both your hands free to handle components while ensuring you can see exactly where every delicate pin is supposed to go."])
texture = ExtResource("8_4fei7")
item_name = "LED Headlamp"

[node name="RJ45" parent="Minigame" node_paths=PackedStringArray("dialog_box") instance=ExtResource("7_5cmuk")]
position = Vector2(-90, 177)
dialog_box = NodePath("../../CanvasLayer/DialogBox")
item_display_name = "Teacher"
final_message = "Great job! You’ve got all your gear on. Let’s get to building!"
item_info = Array[String](["Safety Glasses - It might seem like overkill for a desk job, but PC building involves tension and small parts. ", "When you are clipping plastic zip ties for cable management or using compressed air to blow out a dusty component, small shards or debris can fly directly toward your eyes at high speeds."])
texture = ExtResource("9_5bio5")
item_name = "Safety Glasses"

